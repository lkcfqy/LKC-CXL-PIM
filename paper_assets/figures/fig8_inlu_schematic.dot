digraph "fig8_inlu_schematic" {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.55, ranksep=0.7];
  node [shape=box, style="rounded,filled", color="#333333", fontname="Helvetica", fontsize=12, margin="0.12,0.08"];
  edge [color="#333333", arrowsize=0.8, penwidth=1.4, fontname="Helvetica", fontsize=10];

  input [label="Q10 logits\nx_i", fillcolor="#EAF2FB"];
  reduce [label="Range reduction\nn, f", fillcolor="#E8F6F3"];
  poly [label="Integer polynomial\nexp(f)", fillcolor="#E8F6F3"];
  shift [label="Power-of-two shift\n2^n", fillcolor="#E8F6F3"];
  norm [label="Q24 integer\nnormalization", fillcolor="#F3EAFB"];
  output [label="Attention weights", fillcolor="#EAF2FB"];

  ln2 [label="ln(2)", fillcolor="#FFF3E0"];
  coeff [label="A/B/C constants", fillcolor="#FFF3E0"];

  input -> reduce -> poly -> shift -> norm -> output;
  ln2 -> reduce;
  coeff -> poly;
}
