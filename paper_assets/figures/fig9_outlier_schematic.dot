digraph "fig9_outlier_schematic" {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.55, ranksep=0.7];
  node [shape=box, style="rounded,filled", color="#333333", fontname="Helvetica", fontsize=12, margin="0.12,0.08"];
  edge [color="#333333", arrowsize=0.8, penwidth=1.4, fontname="Helvetica", fontsize=10];

  input [label="Activation\nx", fillcolor="#EAF2FB"];
  compare [label="Abs + threshold\ncompare", fillcolor="#E8F6F3"];
  route [label="Route select", fillcolor="#F3EAFB"];
  int8 [label="Quantized INT8\nmain path", fillcolor="#E8F6F3"];
  outlier [label="High-precision\noutlier buffer\n16 entries", fillcolor="#FFF3E0"];
  merge [label="Merge /\nreduction", fillcolor="#F3EAFB"];
  output [label="PIM output", fillcolor="#EAF2FB"];

  input -> compare -> route;
  route -> int8 [label="common case"];
  route -> outlier [label="|x| > theta"];
  int8 -> merge;
  outlier -> merge;
  merge -> output;
}
